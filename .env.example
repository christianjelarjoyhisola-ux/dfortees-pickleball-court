# Safety marker required by both deployment scripts.
DEPLOYMENT_BRAND=dfortees

# Frontend hosting (create a new D'fortees project before setting these).
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_PAGES_BRANCH=main
CLOUDFLARE_API_TOKEN=

# New D'fortees Supabase project only.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Optional integrations. Leave blank to keep the feature disabled.
PAYMENT_PROVIDER=template
PAYMENT_WEBHOOK_SECRET=
PAYMONGO_SECRET_KEY=
GOOGLE_VISION_API_KEY=
OCR_SPACE_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_LOGO_URL=
APP_ADMIN_URL=
