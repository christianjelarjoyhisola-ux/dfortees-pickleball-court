SUPABASE_DB_PASSWORD=

# Optional integrations. Leave blank to keep the feature disabled.
PAYMENT_PROVIDER=template
PAYMENT_WEBHOOK_SECRET=
PAYMONGO_SECRET_KEY=
GOOGLE_VISION_API_KEY=
EMAIL_PROVIDER=maileroo
MAILEROO_API_KEY=
