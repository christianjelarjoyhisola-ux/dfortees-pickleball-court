# Copy to .env.local for local integration testing. Never commit the copy.
PB_SUPABASE_URL=https://YOUR_NEW_PROJECT_REF.supabase.co
PB_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
PB_TENANT_SLUG=dfortees

# Development project controls. Keep secrets only in the untracked .env.local.
SUPABASE_PROJECT_REF=YOUR_NEW_PROJECT_REF
SUPABASE_ACCESS_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN
PLATFORM_EDGE_DEPLOYMENT_APPROVED=court-booking-platform-dev

# Cloudflare deployment remains opt-in and must never target a Korte project.
DEPLOYMENT_BRAND=dfortees
CLOUDFLARE_PAGES_PROJECT=YOUR_DFORTEES_PAGES_PROJECT
CLOUDFLARE_PAGES_BRANCH=main
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
